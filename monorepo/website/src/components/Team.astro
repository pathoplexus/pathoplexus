---
import { type ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Member = {
    name: string;
    description: string;
    picture: ImageMetadata;
    affiliation?: string;
};

export interface Props {
    members: Member[];
}

const { members } = Astro.props;
---

<div class='grid grid-cols-2 gap-x-5 gap-y-7 sm:grid-cols-3 lg:grid-cols-4'>
    {
        members.map((member) => (
            <div class='min-w-0'>
                <Image
                    src={member.picture}
                    alt={'Picture of ' + member.name}
                    width={320}
                    height={320}
                    class='my-0! border-0! aspect-square w-full rounded-xl object-cover shadow-xs ring-1 ring-black/5'
                />
                <div class='mt-3 text-base font-semibold leading-snug text-gray-900 text-balance hyphens-auto'>
                    {member.name}
                </div>
                <div class='mt-0.5 text-sm leading-snug text-gray-600'>{member.description}</div>
                {member.affiliation !== undefined && (
                    <div class='mt-1 text-sm italic leading-snug text-gray-500'>{member.affiliation}</div>
                )}
            </div>
        ))
    }
</div>
