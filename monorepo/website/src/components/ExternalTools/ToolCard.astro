---
import { getToolUrl, type Tool } from './tools';
import DashiconsExternal from '~icons/dashicons/external';

export interface Props {
    tool: Tool;
    selectedOrganism: string;
}

const { tool, selectedOrganism } = Astro.props;

const toolUrl = getToolUrl(tool, selectedOrganism);
---

<div class='rounded-xl border border-gray-200 bg-white p-5 sm:p-6 shadow-xs transition-shadow hover:shadow-md'>
    <div class='flex flex-col gap-5 sm:flex-row sm:gap-8'>
        <div class='flex h-20 w-20 shrink-0 items-center justify-center sm:h-28 sm:w-28'>
            {
                tool.image ? (
                    <img
                        src={tool.image}
                        alt={`${tool.name} logo`}
                        class='h-full w-full object-contain'
                        loading='lazy'
                    />
                ) : (
                    <div
                        class='flex h-full w-full items-center justify-center rounded-2xl bg-primary-50 text-2xl font-semibold text-primary-700 ring-1 ring-primary-100'
                        aria-hidden='true'
                    >
                        {tool.name.charAt(0)}
                    </div>
                )
            }
        </div>

        <div class='min-w-0 flex-1'>
            <h2 class='text-lg font-semibold text-main mb-2'>
                {tool.name}
            </h2>
            <p class='leading-relaxed text-gray-700'>
                {tool.description}
            </p>
            {
                toolUrl && (
                    <a
                        href={toolUrl}
                        class='mt-4 inline-flex items-center gap-1 rounded-md border border-primary-600/60 px-4 py-1.5 text-sm font-medium text-primary-700 no-underline transition-colors hover:bg-primary-50 hover:no-underline! focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary/40'
                    >
                        Open tool
                        <DashiconsExternal className='ml-1' />
                    </a>
                )
            }
        </div>
    </div>
</div>
