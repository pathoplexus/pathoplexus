---
import { newsItems } from '../../data/newsItems';
import MdLayout from '../../layouts/MdLayout.astro';
---

<MdLayout frontmatter={{ title: 'News', activeTopNavigationItem: '/news/' }}>
    <h1>News</h1>
    <div class='mt-6 space-y-8'>
        {
            newsItems.map((item) => (
                <article class='border-b border-gray-200 pb-8 last:border-b-0'>
                    <h2 class='mt-0!'>
                        <a class='no-underline! hover:underline!' href={`/news/${item.slug}`}>
                            {item.title}
                        </a>
                    </h2>
                    <div class='text-sm text-gray-500'>By the Pathoplexus Team – {item.date}</div>
                    <p class='my-3!'>
                        <Fragment set:html={item.excerpt} />
                    </p>
                    <a class='font-medium no-underline! hover:underline!' href={`/news/${item.slug}`}>
                        Read more <span aria-hidden='true'>→</span>
                    </a>
                </article>
            ))
        }
    </div>
</MdLayout>
